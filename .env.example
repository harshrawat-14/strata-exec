# ── RPC ─────────────────────────────────────────────────────────────
# Use Alchemy / Infura / QuickNode / local node
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ── Chain configuration ─────────────────────────────────────────────
CHAIN_ID=1  # 1=Ethereum, 42161=Arbitrum

# ── Uniswap V2 pair address ─────────────────────────────────────────
# Example: USDC/WETH mainnet
PAIR_ADDRESS=0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc

# ── Execution parameters ────────────────────────────────────────────
TOTAL_NOTIONAL=10000.0
BASE_CHUNK=500.0
MAX_SLIPPAGE_PCT=0.05
EMERGENCY_RESERVE_FRAC=0.2

# ── Volatility estimator ────────────────────────────────────────────
VOL_WINDOW=20
SIGMA_REF=0.02

# ── Liquidity reference ─────────────────────────────────────────────
LIQUIDITY_REF=1000.0

# ── Server / logging ────────────────────────────────────────────────
LOG_LEVEL=info
HTTP_PORT=3000