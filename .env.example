# StrataExec — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── RPC ─────────────────────────────────────────────────────────────
RPC_URL=http://localhost:8545

# ── Uniswap V2 pair address (checksummed) ───────────────────────────
PAIR_ADDRESS=0x0000000000000000000000000000000000000000

# ── Execution parameters ────────────────────────────────────────────
TOTAL_NOTIONAL=10000.0
BASE_CHUNK=500.0
MAX_SLIPPAGE_PCT=0.05
EMERGENCY_RESERVE_FRAC=0.2

# ── Volatility estimator ───────────────────────────────────────────
VOL_WINDOW=20
SIGMA_REF=0.02

# ── Liquidity reference ────────────────────────────────────────────
LIQUIDITY_REF=1000.0

# ── Execution model (heuristic | optimal) ──────────────────────────
EXECUTION_MODE=heuristic
# ETA=0.1              # temporary impact coefficient (required for optimal)
# LAMBDA=0.01          # risk aversion (>= 0)
# HORIZON_BLOCKS=50    # optional horizon override; auto-computed if omitted

# ── Server / logging (optional — have defaults) ────────────────────
LOG_LEVEL=info
HTTP_PORT=3000